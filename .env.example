# Salin berkas ini menjadi .env lalu sesuaikan bila perlu.
#   Windows (PowerShell): copy .env.example .env
#   Mac/Linux:            cp .env.example .env

APP_ENV=development

# Basis data PostgreSQL (dijalankan lewat Docker: docker compose up -d)
# Jika port 5432 sudah dipakai PostgreSQL lain di laptop, ganti DB_PORT=5433
# dan ubah angka 5432 di DATABASE_URL menjadi 5433.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://gwasena:gwasena@localhost:5432/gwasena

# Opsi TANPA Docker dan tanpa PostgreSQL (khusus pengembangan lokal):
# beri tanda # pada DATABASE_URL di atas, lalu hapus tanda # pada baris berikut.
# DATABASE_URL=sqlite:///./storage/gwasena_dev.db

# Redis (antrean tugas Celery untuk komputasi asinkron)
REDIS_URL=redis://localhost:6379/0

# Alamat frontend yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Buat tabel otomatis saat backend dinyalakan (tahap awal; nanti diganti Alembic)
AUTO_CREATE_TABLES=true

# Folder penyimpanan berkas unggahan
UPLOAD_DIR=./storage/uploads

# Kunci untuk menandatangani token login. Ganti dengan teks acak yang panjang.
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang
TOKEN_EXPIRE_HOURS=12
