# Salin berkas ini menjadi .env lalu sesuaikan bila perlu.
#   Windows (PowerShell): copy .env.example .env
#   Mac/Linux:            cp .env.example .env

APP_ENV=development

# Basis data PostgreSQL (dijalankan lewat Docker: docker compose up -d)
# Jika port 5432 sudah dipakai PostgreSQL lain di laptop, ganti DB_PORT=5433
# dan ubah angka 5432 di DATABASE_URL menjadi 5433.
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://gwasena:gwasena@localhost:5432/gwasena

# Opsi TANPA Docker dan tanpa PostgreSQL (khusus pengembangan lokal):
# beri tanda # pada DATABASE_URL di atas, lalu hapus tanda # pada baris berikut.
# DATABASE_URL=sqlite:///./storage/gwasena_dev.db

# Redis (antrean tugas Celery untuk komputasi asinkron)
REDIS_URL=redis://localhost:6379/0

# Alamat frontend yang boleh memanggil API (dipisah koma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Buat tabel otomatis saat backend dinyalakan (tahap awal; nanti diganti Alembic)
AUTO_CREATE_TABLES=true

# Folder penyimpanan berkas unggahan
UPLOAD_DIR=./storage/uploads

# Kunci untuk menandatangani token login. Ganti dengan teks acak yang panjang.
SECRET_KEY=ganti-dengan-teks-acak-yang-panjang
TOKEN_EXPIRE_HOURS=12

# Cara menjalankan pipeline: auto | celery | background
#   auto: pakai Celery bila worker menyala, selain itu jalan di latar belakang FastAPI
PIPELINE_MODE=auto
# Tanpa Redis/Celery, isi PIPELINE_MODE=background

# Anotasi gen kandidat (FR-07).
# ANNOTATION_SOURCE=ensembl  -> semua organisme lewat Ensembl REST API (bawaan; GFF3 lokal tidak dipakai)
# ANNOTATION_SOURCE=otomatis -> bawang putih memakai GFF3 lokal di bawah, organisme lain lewat Ensembl
ANNOTATION_SOURCE=ensembl
# Berkas anotasi genom GFF3 (hanya dipakai bila ANNOTATION_SOURCE=otomatis) dan jendela pencarian gen (bp).
# Bawaan memakai berkas CONTOH untuk data dummy; ganti dengan GFF3 genom bawang putih asli bila tersedia.
ANNOTATION_GFF3=./data/contoh/anotasi_bawang_putih_contoh.gff3
ANNOTATION_WINDOW_BP=50000
# Batas waktu total (detik) satu kali anotasi melalui Ensembl REST API (organisme selain bawang putih).
ANNOTATION_TIMEOUT_TOTAL=25
# true = anotasi gen kandidat langsung dihitung setelah analisis selesai lalu disimpan (cache).
ANNOTATION_AUTO=true

# Login Google: isi dengan OAuth Client ID (Google Cloud Console > Credentials).
# Nilainya sama dengan VITE_GOOGLE_CLIENT_ID di frontend/.env. Kosong = login Google mati.
GOOGLE_CLIENT_ID=

# Batas titik Manhattan plot sebelum diringkas (smart downsampling)
MANHATTAN_MAX_POINTS=20000

# Akun demo (user_demo, admin, dll. dengan kata sandi password123) untuk pengembangan/pengujian.
# Otomatis mati bila APP_ENV=production. Isi false bila tidak ingin akun demo dibuat.
SEED_DEMO_USERS=true
